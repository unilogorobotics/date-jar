rules_version = '2';

// Data model
//   jars/{jarId}                 { name, createdBy, createdAt, inviteCode, members: [uid], memberInfo: { uid: {...} } }
//   jars/{jarId}/ideas/{ideaId}  { text, category, budget, done, doneAt, addedBy, addedByName, createdAt }
//
// Only members can see a jar. Someone with an invite link (jarId + secret inviteCode)
// can add *themselves* to the jar by proving they know the code.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    match /jars/{jarId} {
      function isMember() { return signedIn() && uid() in resource.data.members; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function validName() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
      }
      function validCode() {
        return request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() >= 16;
      }
      function onlyOwnMemberInfo() {
        return request.resource.data.memberInfo.diff(resource.data.memberInfo)
          .affectedKeys().hasOnly([uid()]);
      }

      allow read: if isMember();

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.memberInfo.keys().hasOnly([uid()])
        && validName()
        && validCode();

      // Members: rename the jar, rotate the invite code, refresh their own profile.
      allow update: if isMember()
        && changed().hasOnly(['name', 'inviteCode', 'memberInfo'])
        && validName()
        && validCode()
        && onlyOwnMemberInfo();

      // Members: leave the jar (remove only themselves).
      allow update: if isMember()
        && changed().hasOnly(['members', 'memberInfo'])
        && request.resource.data.members == resource.data.members.removeAll([uid()])
        && onlyOwnMemberInfo();

      // Invitees: join by presenting the secret invite code.
      allow update: if signedIn()
        && !(uid() in resource.data.members)
        && resource.data.members.size() < 20
        && changed().hasOnly(['members', 'memberInfo'])
        && request.resource.data.members == resource.data.members.concat([uid()])
        && onlyOwnMemberInfo()
        && request.resource.data.memberInfo[uid()].joinCode == resource.data.inviteCode;

      // The last member may delete the jar.
      allow delete: if isMember() && resource.data.members.size() == 1;

      match /ideas/{ideaId} {
        function jarMember() {
          return signedIn()
            && uid() in get(/databases/$(database)/documents/jars/$(jarId)).data.members;
        }
        function validIdea() {
          let d = request.resource.data;
          return d.text is string && d.text.size() > 0 && d.text.size() <= 200
            && d.category is string && d.category.size() <= 30
            && d.budget is int && d.budget >= 0 && d.budget <= 3
            && d.done is bool;
        }

        allow read, delete: if jarMember();
        allow create: if jarMember() && validIdea() && request.resource.data.addedBy == uid();
        allow update: if jarMember() && validIdea()
          && request.resource.data.addedBy == resource.data.addedBy;
      }
    }
  }
}
