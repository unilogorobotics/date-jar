{
  "name": "date-jar",
  "version": "1.0.0",
  "private": true,
  "description": "A shared date-idea jar for couples, with Google sign-in",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-date-jar",
    "dev:emulated": "VITE_USE_EMULATORS=true VITE_FIREBASE_PROJECT_ID=demo-date-jar VITE_FIREBASE_API_KEY=demo-key VITE_FIREBASE_AUTH_DOMAIN=localhost vite",
    "deploy": "vite build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "firebase": "^13.4.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.37.0",
    "vite": "^8.3.8"
  }
}
